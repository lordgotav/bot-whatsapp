# ============================================================
#  COPIA ESTE ARCHIVO A ".env" Y LLENA LOS VALORES
#  (en Render, pega estos mismos campos en Environment)
# ============================================================

# --- Proveedor de WhatsApp ---
# 'meta'   = WhatsApp Cloud API oficial de Meta (predeterminado)
# 'zernio' = Zernio API (https://zernio.com): oficial, sin crear app en Meta
PROVEEDOR=meta

# --- Solo si PROVEEDOR=meta: Meta / WhatsApp Cloud API ---
# Token del paso 5 (temporal) o permanente del System User
WHATSAPP_TOKEN=EAA_cambia_esto...
# Aparece en la pantalla "API Setup": un número de 15 dígitos
PHONE_NUMBER_ID=10987654321
# La palabra secreta que inventaste al configurar el webhook
VERIFY_TOKEN=mi-token-de-verificacion

# --- Solo si PROVEEDOR=zernio : Zernio API ---
# Tu API key de https://zernio.com (dashboard)
ZERNIO_API_KEY=zernio_cambia_esto...
# Secret que TU asignas en "POST /v1/webhooks/settings" (firma HMAC del webhook).
# Con él el bot valida que los mensajes vienen de Zernio. Muy recomendado.
ZERNIO_WEBHOOK_SECRET=elige_un_secreto_largo

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# ⚠️ clave SERVICE_ROLE (Settings -> API -> service_role). Es secreta, no la compartas.
SUPABASE_SERVICE_KEY=eyJ...tu_service_role_key...

# --- Turno de la obra ---
# UNA SOLA OBRA: ID del turno en monitoreo_turnos (Table Editor -> monitoreo_turnos).
# Se puede dejar vacío si usas OBRA:
TURNO_ID=
# Nombre exacto de la obra (se usa si TURNO_ID está vacío)
OBRA=
#
# VARIAS OBRAS (multi-obra): deja TURNO_ID y OBRA VACÍOS. El bot preguntará a
# cada supervisor "¿En qué obra estás?" la primera vez y lo recordará
# (tabla supervisor_turnos). Para cambiar: escribe "cambiar obra".

# --- Puerto (Render lo asigna solo; por defecto 3000) ---
PORT=3000

# ============================================================
#  BOT DE VENTAS - SECURY INOVATECH (servicios + FAQ + embudo)
# ============================================================

# Nombre de la empresa tal como se firma el bot
EMPRESA_NOMBRE=SECURY INOVATECH

# Número del asesor que recibe el AVISO de WhatsApp cuando un
# prospecto saca score alto y agenda cita. Solo dígitos, con
# código de país (ej. México: 52 + 10 dígitos = 528331039200).
# Déjalo vacío si todavía no quieres recibir avisos.
ASESOR_WA=

# Puntaje mínimo para ofrecer cita demo (por defecto 40)
# < umbral = prospecto frío, se le ofrece que le escriban después
DEMO_UMBRAL=40

# ¿Avisar también a los prospectos "tibios"? true / false
AVISAR_TIBIOS=false

# Desfase horario para los slots de cita (formato ISO, México = -06:00)
DEMO_UTC_OFFSET=-06:00