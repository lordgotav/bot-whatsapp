# ============================================================
#  COPIA ESTE ARCHIVO A ".env" Y LLENA LOS VALORES
#  (en Render, pega estos mismos campos en Environment)
# ============================================================

# --- Meta / WhatsApp Cloud API ---
# Token del paso 5 (temporal) o permanente del System User
WHATSAPP_TOKEN=EAA_cambia_esto...
# Aparece en la pantalla "API Setup": un número de 15 dígitos
PHONE_NUMBER_ID=10987654321
# La palabra secreta que inventaste al configurar el webhook
VERIFY_TOKEN=mi-token-de-verificacion

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# ⚠️ clave SERVICE_ROLE (Settings -> API -> service_role). Es secreta, no la compartas.
SUPABASE_SERVICE_KEY=eyJ...tu_service_role_key...

# --- Turno de la obra ---
# UNA SOLA OBRA: ID del turno en monitoreo_turnos (Table Editor -> monitoreo_turnos).
# Se puede dejar vacío si usas OBRA:
TURNO_ID=
# Nombre exacto de la obra (se usa si TURNO_ID está vacío)
OBRA=
#
# VARIAS OBRAS (multi-obra): deja TURNO_ID y OBRA VACÍOS. El bot preguntará a
# cada supervisor "¿En qué obra estás?" la primera vez y lo recordará
# (tabla supervisor_turnos). Para cambiar: escribe "cambiar obra".

# --- Puerto (Render lo asigna solo; por defecto 3000) ---
PORT=3000